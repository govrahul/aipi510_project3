# Copy to .env and fill in YOUR OWN values:  cp .env.example .env
# Never commit .env

# Kaggle (kaggle.com > Settings > API > Create New Token)
# Optional if you already put water_potability.csv in Data/ yourself
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# Weights & Biases (https://wandb.ai/authorize)
WANDB_API_KEY=your-wandb-api-key
WANDB_ENTITY=your-wandb-username-or-team
WANDB_PROJECT=water-potability-510-project3

# Google Cloud
GCP_PROJECT=your-gcp-project-id
GCS_BUCKET=your-unique-bucket-name
# Path INSIDE the container where the key file is mounted (see docker run -v)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
